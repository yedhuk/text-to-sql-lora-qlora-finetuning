# ── Virtual environment ──────────────────────────────────────────────────────
.venv/
venv/
env/

# ── Python bytecode / caches ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ipynb_checkpoints/

# ── Generated data (reproducible: `python data/prepare_data.py`) ─────────────
data/*.jsonl

# ── Run artifacts: trained adapters, telemetry, eval dumps, summaries ────────
# Everything here is regenerated by `python run_benchmark.py`.
outputs/
# If you DO want to version the final summary, force-add it explicitly:
#   git add -f outputs/benchmark_summary.md

# ── Experiment trackers (in case report_to is ever switched on) ──────────────
wandb/
runs/
*.log

# ── Hugging Face cache, only if you redirect it INTO the repo via HF_HOME ────
# (default cache lives in ~/.cache/huggingface and is already outside the repo)
# .hf_cache/
# hf_home/

# ── Editor / OS cruft ────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ── Secrets / local env ──────────────────────────────────────────────────────
.env
*.local